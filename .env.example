# Backend origin. The API must listen on 0.0.0.0 (not only 127.0.0.1) when a
# phone or emulator will call it.
#
# localhost is rewritten in development:
# - physical device: the Expo dev server's host (your computer's LAN address)
# - Android emulator, when that host is unavailable: 10.0.2.2
# - iOS simulator and web: localhost, which is this computer
#
# Set a non-loopback URL (a LAN address, or the deployed API) to skip rewriting.
# Production builds do not rewrite localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public Supabase project settings. This is the anon key, not the service-role key.
# Never put the service-role key, database password, or other privileged secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
